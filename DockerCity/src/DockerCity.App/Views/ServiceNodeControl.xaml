<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DockerCity.App.Views.ServiceNodeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DockerCity.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:CategoryToBrushConverter x:Key="CategoryBrush" />
    </UserControl.Resources>

    <StackPanel Width="120" Spacing="4" ToolTipService.ToolTip="{Binding Description}">

        <Border Width="72"
                Height="72"
                CornerRadius="14"
                HorizontalAlignment="Center"
                Background="{Binding Category, Converter={StaticResource CategoryBrush}}">
            <TextBlock Text="{Binding Initials}"
                       Foreground="White"
                       FontSize="24"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Border>

        <TextBlock Text="{Binding Name}"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Stretch" />

        <TextBlock Text="{Binding ImageLabel}"
                   Opacity="0.6"
                   FontSize="11"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Stretch" />

        <TextBlock Text="{Binding Badges}"
                   Opacity="0.45"
                   FontSize="10"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Stretch" />
    </StackPanel>
</UserControl>
