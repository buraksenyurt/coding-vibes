<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DockerCity.App.Views.ServiceNodeControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="using:DockerCity.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:CategoryToBrushConverter x:Key="CategoryBrush" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <StackPanel Width="120"
                Spacing="4"
                ToolTipService.ToolTip="{Binding TooltipText}"
                PointerEntered="OnPointerEntered"
                PointerExited="OnPointerExited">

        <!-- Only the icon bounces on hover; the labels stay put so they remain
             readable while the pointer is over them. -->
        <Grid x:Name="IconHost" Width="82" Height="82" HorizontalAlignment="Center">

            <!-- Always present, faded out when not selected. Keeps the control
                 free of value converters and avoids a layout shift on select. -->
            <Border CornerRadius="20"
                    BorderThickness="2.5"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    Opacity="{Binding SelectionOpacity}" />

            <Border Width="72"
                    Height="72"
                    CornerRadius="14"
                    Background="{Binding Category, Converter={StaticResource CategoryBrush}}">
                <TextBlock Text="{Binding Initials}"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <!-- The sentinel: this service is brought back by Docker whenever it
                 stops (restart: always or unless-stopped). -->
            <Border Width="24"
                    Height="24"
                    CornerRadius="12"
                    Margin="0,-2,-2,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    BorderThickness="2"
                    BorderBrush="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                    Visibility="{Binding IsSupervised, Converter={StaticResource BoolToVisibility}}"
                    ToolTipService.ToolTip="{Binding SupervisedText}">
                <FontIcon Glyph="&#xE72C;"
                          FontSize="11"
                          Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
        </Grid>

        <TextBlock Text="{Binding Name}"
                   FontWeight="SemiBold"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Stretch" />

        <TextBlock Text="{Binding ImageLabel}"
                   Opacity="0.6"
                   FontSize="11"
                   TextAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Stretch" />

        <TextBlock Text="{Binding Badges}"
                   Opacity="0.45"
                   FontSize="10"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Stretch" />
    </StackPanel>
</UserControl>
