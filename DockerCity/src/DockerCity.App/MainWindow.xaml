<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DockerCity.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DockerCity.App.Controls"
    xmlns:converters="using:DockerCity.App.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- A Window is not a FrameworkElement in WinUI, so it has no DataContext
         or Resources. Both live on this root Grid instead. AllowDrop is here
         too, so a file can be dropped anywhere in the window. -->
    <Grid x:Name="RootGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          AllowDrop="True"
          DragOver="OnDragOver"
          Drop="OnDrop">

        <Grid.Resources>
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        </Grid.Resources>

        <!-- Shortcuts live on the root, not on the menu items: accelerators on
             flyout items are not reliably active while the menu is closed. -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnOpenAccelerator" />
            <KeyboardAccelerator Key="F5" Invoked="OnReloadAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="E" Invoked="OnExportAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="R" Invoked="OnResetAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnToggleDetailsAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnToggleLinksAccelerator" />
            <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="OnToggleDistrictsAccelerator" />
            <KeyboardAccelerator Key="Escape" Invoked="OnEscapeAccelerator" />
            <KeyboardAccelerator Key="F1" Invoked="OnShortcutsAccelerator" />
            <!-- Zoom and mini map shortcuts are added in code: Ctrl+Plus and
                 Ctrl+Minus sit on OEM keys that VirtualKey has no name for. -->
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ============================ Menu ============================ -->
        <Grid Grid.Row="0" Grid.ColumnSpan="2" Padding="4,0,16,0">
            <MenuBar>
                <MenuBarItem Title="File">
                    <MenuFlyoutItem Text="Open..." KeyboardAcceleratorTextOverride="Ctrl+O" Click="OnOpenClick" />
                    <MenuFlyoutSubItem x:Name="RecentMenu" Text="Open recent" />
                    <MenuFlyoutItem Text="Reload" KeyboardAcceleratorTextOverride="F5" Click="OnReloadClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Export as PNG..." KeyboardAcceleratorTextOverride="Ctrl+E" Click="OnExportClick" />
                    <MenuFlyoutSeparator />
                    <ToggleMenuFlyoutItem x:Name="ReopenLastItem" Text="Reopen last file on start" Click="OnReopenLastClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Exit" Click="OnExitClick" />
                </MenuBarItem>

                <MenuBarItem Title="View">
                    <ToggleMenuFlyoutItem x:Name="DetailsItem" Text="Details panel" KeyboardAcceleratorTextOverride="Ctrl+1" Click="OnToggleDetailsClick" />
                    <ToggleMenuFlyoutItem x:Name="LinksItem" Text="Roads" KeyboardAcceleratorTextOverride="Ctrl+2" Click="OnToggleLinksClick" />
                    <ToggleMenuFlyoutItem x:Name="DistrictsItem" Text="District borders" KeyboardAcceleratorTextOverride="Ctrl+3" Click="OnToggleDistrictsClick" />
                    <ToggleMenuFlyoutItem x:Name="MinimapItem" Text="Mini map" KeyboardAcceleratorTextOverride="Ctrl+4" Click="OnToggleMinimapClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Zoom in" KeyboardAcceleratorTextOverride="Ctrl+Plus" Click="OnZoomInClick" />
                    <MenuFlyoutItem Text="Zoom out" KeyboardAcceleratorTextOverride="Ctrl+Minus" Click="OnZoomOutClick" />
                    <MenuFlyoutItem Text="Actual size" KeyboardAcceleratorTextOverride="Ctrl+0" Click="OnActualSizeClick" />
                    <MenuFlyoutItem Text="Fit to window" KeyboardAcceleratorTextOverride="Ctrl+9" Click="OnFitClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutSubItem Text="Theme">
                        <RadioMenuFlyoutItem x:Name="ThemeSystemItem" Text="Use system setting" GroupName="Theme" Click="OnThemeClick" Tag="System" />
                        <RadioMenuFlyoutItem x:Name="ThemeLightItem" Text="Light" GroupName="Theme" Click="OnThemeClick" Tag="Light" />
                        <RadioMenuFlyoutItem x:Name="ThemeDarkItem" Text="Dark" GroupName="Theme" Click="OnThemeClick" Tag="Dark" />
                    </MenuFlyoutSubItem>
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="Reset layout" KeyboardAcceleratorTextOverride="Ctrl+R" Click="OnResetClick" />
                </MenuBarItem>

                <MenuBarItem Title="Help">
                    <MenuFlyoutItem Text="Keyboard shortcuts" KeyboardAcceleratorTextOverride="F1" Click="OnShortcutsClick" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Text="About DockerCity" Click="OnAboutClick" />
                </MenuBarItem>
            </MenuBar>

            <ProgressRing IsActive="{Binding IsBusy}"
                          Width="18"
                          Height="18"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center" />
        </Grid>

        <!-- ============================ City ============================ -->
        <!-- Zooming is the ScrollViewer's job: Ctrl+wheel and touchpad pinch
             work out of the box, and the canvas keeps its own coordinates. -->
        <ScrollViewer x:Name="CityScroller"
                      Grid.Row="1"
                      Grid.Column="0"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      ZoomMode="Enabled"
                      MinZoomFactor="0.25"
                      MaxZoomFactor="3"
                      Visibility="{Binding HasCity, Converter={StaticResource BoolToVisibility}}">
            <!-- The frame gives the export a background: the canvas itself is
                 transparent, and a transparent PNG loses its dark-theme text. -->
            <Border x:Name="CityFrame" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <controls:CityCanvas x:Name="CityBoard"
                                     Width="{Binding CanvasWidth}"
                                     Height="{Binding CanvasHeight}"
                                     ShowLinks="{Binding ShowLinks}"
                                     ShowDistricts="{Binding ShowDistricts}" />
            </Border>
        </ScrollViewer>

        <!-- Outside the ScrollViewer, so it neither scrolls nor zooms. -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,20,20"
                Padding="4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                Opacity="0.92"
                Visibility="{Binding IsMinimapVisible, Converter={StaticResource BoolToVisibility}}">
            <controls:MinimapControl x:Name="Minimap" Width="220" Height="150" />
        </Border>

        <InfoBar Grid.Row="1"
                 Grid.Column="0"
                 Margin="16"
                 MaxWidth="560"
                 VerticalAlignment="Top"
                 HorizontalAlignment="Center"
                 Severity="Informational"
                 Title="File changed on disk"
                 Message="The compose file was edited outside DockerCity."
                 IsOpen="{Binding IsFileChangedOnDisk, Mode=TwoWay}">
            <InfoBar.ActionButton>
                <Button Content="Reload" Click="OnReloadClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- ========================== Welcome =========================== -->
        <Grid Grid.Row="1"
              Grid.Column="0"
              Visibility="{Binding HasCity, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="520"
                        Spacing="16">

                <TextBlock Text="DockerCity" Style="{ThemeResource TitleLargeTextBlockStyle}" />
                <TextBlock Text="Open a docker-compose file to see it as a city."
                           Style="{ThemeResource BodyTextBlockStyle}"
                           Opacity="0.7" />

                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="Open compose file..."
                            Style="{ThemeResource AccentButtonStyle}"
                            Click="OnOpenClick" />
                    <TextBlock Text="or drop a .yml file anywhere in this window"
                               Opacity="0.5"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="Recent"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           Margin="0,16,0,0" />

                <ListView ItemsSource="{Binding RecentFiles}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnRecentItemClick"
                          MaxHeight="320">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="0,6" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding FilePath}"
                                           Opacity="0.6"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LastOpenedText}" Opacity="0.4" FontSize="11" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Grid>

        <!-- ======================== Detail panel ======================== -->
        <Border Grid.Row="1"
                Grid.Column="1"
                Width="320"
                Padding="20,16"
                BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Visibility="{Binding IsDetailsPanelVisible, Converter={StaticResource BoolToVisibility}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">

                    <TextBlock Text="{Binding SelectionTitle}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Spacing="2">
                        <TextBlock Text="Image" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.ImageLabel}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Container" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.ContainerText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Category" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.CategoryText}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Networks" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.NetworksText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Ports" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.PortsText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Volumes" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.VolumesText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Depends on" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.DependsOnText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Needed by" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding NeededByText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Command" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.CommandText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Environment" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.EnvironmentText}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ========================== Status ============================ -->
        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Padding="16,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Status}"
                           Opacity="0.7"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <HyperlinkButton x:Name="ZoomButton"
                                 Grid.Column="1"
                                 Content="100%"
                                 FontSize="12"
                                 Padding="6,0"
                                 ToolTipService.ToolTip="Back to actual size (Ctrl+0)"
                                 Click="OnActualSizeClick"
                                 Visibility="{Binding HasCity, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
