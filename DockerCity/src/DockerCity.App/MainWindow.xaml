<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DockerCity.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DockerCity.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- A Window is not a FrameworkElement in WinUI, so it has no DataContext.
         The view model is attached to this root Grid instead. -->
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="12"
                    Padding="16,12">
            <Button x:Name="OpenButton"
                    Content="Open compose file..."
                    Click="OnOpenClick" />
            <ProgressRing IsActive="{Binding IsBusy}"
                          Width="20"
                          Height="20"
                          VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      ZoomMode="Disabled">
            <controls:CityCanvas x:Name="CityBoard"
                                 Width="{Binding CanvasWidth}"
                                 Height="{Binding CanvasHeight}" />
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="16,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock Text="{Binding Status}"
                       Opacity="0.7"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
