<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DockerCity.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:DockerCity.App.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- A Window is not a FrameworkElement in WinUI, so it has no DataContext.
         The view model is attached to this root Grid instead. -->
    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="12"
                    Padding="16,12">
            <Button x:Name="OpenButton"
                    Content="Open compose file..."
                    Click="OnOpenClick" />
            <Button x:Name="ResetButton"
                    Content="Reset layout"
                    Click="OnResetClick" />
            <ProgressRing IsActive="{Binding IsBusy}"
                          Width="20"
                          Height="20"
                          VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Grid.Column="0"
                      HorizontalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      ZoomMode="Disabled">
            <controls:CityCanvas x:Name="CityBoard"
                                 Width="{Binding CanvasWidth}"
                                 Height="{Binding CanvasHeight}" />
        </ScrollViewer>

        <Border Grid.Row="1"
                Grid.Column="1"
                Width="320"
                Padding="20,16"
                BorderThickness="1,0,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">

                    <TextBlock Text="{Binding SelectionTitle}"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />

                    <StackPanel Spacing="2">
                        <TextBlock Text="Image" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.ImageLabel}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Container" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.ContainerText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Category" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.CategoryText}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Networks" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.NetworksText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Ports" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.PortsText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Volumes" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.VolumesText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Depends on" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.DependsOnText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Needed by" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding NeededByText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Command" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.CommandText}" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="Environment" Opacity="0.5" FontSize="11" />
                        <TextBlock Text="{Binding Selected.EnvironmentText}"
                                   FontFamily="Consolas"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2"
                Grid.ColumnSpan="2"
                Padding="16,8"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock Text="{Binding Status}"
                       Opacity="0.7"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis" />
        </Border>
    </Grid>
</Window>
